# =========================================================
# KMCLU Confession Wall — Environment Variables
# =========================================================

# 1. MongoDB Atlas Connection String
# Replace <username> and <password> with your Atlas database user credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kmclu-confessions?retryWrites=true&w=majority

# 2. NextAuth.js Configuration
AUTH_SECRET=generate-a-random-secret-key-for-production
NEXTAUTH_SECRET=generate-a-random-secret-key-for-production
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# 3. Admin Credentials (also pre-stored in MongoDB via `npm run seed:admin`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@kmclu.com
ADMIN_PASSWORD=admin123

# 4. Official Sponsor Link (Ilham Chikankari)
NEXT_PUBLIC_SPONSOR_URL=https://www.instagram.com/ilhamchikankari/

# 5. Campus Social Media Links
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/kmcluconfessions/
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/kmclu
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/kmclu_confessions
NEXT_PUBLIC_TWITTER_URL=https://x.com/kmcluconfessions
NEXT_PUBLIC_COMMUNITY_URL=https://www.instagram.com/
